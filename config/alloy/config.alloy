// config-alloy/config.alloy

// 1. Alloy Internal Server Configuration
logging {
    level  = "info"
    format = "logfmt"
}

// 2. Docker Container Discovery
discovery.docker "containers" {
    host = "tcp://docker-socket-proxy:2375"
}

// 3. Relabeling to clean container names
//    Equivalent to your previous regex '/(.*)'
discovery.relabel "docker_logs" {
    targets = discovery.docker.containers.targets

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container"
    }

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "job"
    }

    // Extract Docker Compose project name (e.g., 'symfony-app', 'wordpress-app')
    rule {
        source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
        target_label  = "project"
    }

    // Extract Docker Compose service name (e.g., 'web', 'php', 'db')
    rule {
        source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
        target_label  = "service"
    }

    // Fallback: extract project/service from container name.
    // Matches patterns like:
    //   ule-evadoc-mariadb   → project: ule-evadoc, service: mariadb
    //   myproject-app        → project: myproject, service: app
    //   ule-evadoc           → project: ule-evadoc (no service match, falls through)
    rule {
        source_labels = ["container"]
        regex         = "^([^-]+)-(.+)$"
        target_label  = "project"
        replacement   = "${1}"
    }

    rule {
        source_labels = ["container"]
        regex         = "^([^-]+)-(.+)$"
        target_label  = "service"
        replacement   = "${2}"
    }

    // Fallback for containers without a dash in their name (e.g. "ule-evadoc")
    rule {
        source_labels = ["project"]
        regex         = "^$"
        target_label  = "project"
        replacement   = "${container}"
    }

    // Fallback for containers without a service extracted
    rule {
        source_labels = ["service"]
        regex         = "^$"
        target_label  = "service"
        replacement   = "app"
    }
}

// 4. Log Ingestion (Input)
loki.source.docker "default" {
    host       = "tcp://docker-socket-proxy:2375"
    targets    = discovery.relabel.docker_logs.output
    forward_to = [loki.process.pipelines.receiver]
}

// 5. Log Processing (Pipelines)
loki.process "pipelines" {
    
    // 5.1 Drop noise: Remove self-monitoring logs and tools
    stage.drop {
        expression = ".*(alloy|loki|grafana|dozzle|watchdog).*"
        source     = "container"
    }

    // ============================================
    // TRAEFIK PIPELINE
    // ============================================
    stage.match {
        selector = "{container=~\".*traefik.*\"}"
        
        stage.json {
            expressions = {
                client_ip  = "ClientHost",
                status     = "DownstreamStatus",
                method     = "RequestMethod",
                host       = "RequestHost",
                router     = "RouterName",
                duration   = "Duration",
                user_agent = "RequestHeader_User_Agent",
            }
        }
        
        stage.labels {
            values = {
                status   = "status",
                method   = "method",
                host     = "host",
                router   = "router",
                log_type = "access",
            }
        }
    }

    // ============================================
    // APACHE / PHP PIPELINE
    // Handles both JSON access logs (Zend/WordPress) and combined format (Symfony)
    // ============================================
    stage.match {
        selector = "{container=~ \".*php.*|.*apache.*\"}"

        // --- JSON ACCESS LOG BRANCH ---
        // Zend and WordPress use json_combined format
        stage.match {
            selector = "{} |~ \"^\\{\\s*\\\"time\\\"\""

            stage.json {
                expressions = {
                    apache_time = "time",
                    remote_ip   = "remote_ip",
                    host        = "host",
                    method      = "method",
                    uri         = "uri",
                    status      = "status",
                    duration    = "duration_us",
                    referer     = "referer",
                    user_agent  = "user_agent",
                }
            }

            stage.labels {
                values = {
                    status   = "status",
                    method   = "method",
                    host     = "host",
                    log_type = "access",
                }
            }

            // Timestamp: "2025-12-04T15:01:17+0100"
            stage.timestamp {
                source = "apache_time"
                format = "2006-01-02T15:04:05-0700"
            }
        }

        // --- COMBINED FORMAT ACCESS LOG BRANCH ---
        // Symfony/ule-evadoc uses standard Apache combined format
        stage.match {
            selector = "{} !~ \"^\\{\\s*\\\"time\\\"\""

            // Try to parse as Apache combined format
            stage.regex {
                expression = "^(?P<client_ip>[\\d.]+) (?P<identd>\\S+) (?P<user>\\S+) \\[(?P<timestamp>[^\\]]+)\\] \"(?P<method>\\w+) (?P<path>[^ ]*) [^\"]*\" (?P<status>\\d+) (?P<bytes>\\d+|-) \"(?P<referer>[^\"]*)\" \"(?P<user_agent>[^\"]*)\""
            }

            stage.labels {
                values = {
                    method    = "",
                    status    = "",
                    log_type  = "access",
                }
            }

            // Parse Apache timestamp: 14/Dec/2024:16:30:00 +0100
            stage.timestamp {
                source = "timestamp"
                format = "02/Jan/2006:15:04:05 -0700"
            }
        }
    }

    // ============================================
    // SYMFONY / MONolog JSON PIPELINE
    // Symfony apps (ule-evadoc) emit Monolog JSON to stderr when in prod mode
    // ============================================
    stage.match {
        selector = "{container=~ \".*evadoc.*|.*symfony.*\"}"

        stage.json {
            expressions = {
                monolog_time    = "datetime",
                monolog_level   = "level_name",
                monolog_channel = "channel",
                monolog_msg     = "message",
                monolog_context = "context",
            }
        }

        stage.labels {
            values = {
                level    = "monolog_level",
                channel  = "monolog_channel",
                log_type = "app",
            }
        }

        // Monolog uses ISO8601: "2024-12-14T10:00:00.123456+01:00"
        stage.timestamp {
            source = "monolog_time"
            format = "RFC3339Nano"
        }
    }

    // ============================================
    // ANUBIS PIPELINE
    // ============================================
    stage.match {
        selector = "{container=~ \".*anubis.*\"}"

        stage.json {
            expressions = {
                anubis_time  = "time",
                level        = "level",
                msg          = "msg",
                host         = "host",
                method       = "method",
                path         = "path",
                // JMESPath escape for keys with hyphens
                real_ip      = "\"x-real-ip\"",
                challenge_id = "challenge",
            }
        }

        stage.labels {
            values = {
                level    = "level",
                host     = "host",
                method   = "method",
                msg      = "msg",
                log_type = "level",
            }
        }

        // Anubis uses RFC3339Nano
        stage.timestamp {
            source = "anubis_time"
            format = "RFC3339Nano"
        }
    }

    // ============================================
    // GENERIC APPLICATION PIPELINE (Zend, WordPress, etc.)
    // Catches all containers that are not Traefik, Anubis, or internal tools.
    // Attempts to extract log level from common plain-text patterns.
    // ============================================
    stage.match {
        selector = "{container!~ \".*traefik.*|.*anubis.*|.*alloy.*|.*loki.*|.*grafana.*|.*dozzle.*|.*watchdog.*|.*crowdsec.*|.*redis.*|.*postgres.*|.*prometheus.*|.*node-exporter.*|.*php.*|.*apache.*|.*evadoc.*|.*symfony.*\"}"

        // Fallback: extract level from common PHP / Monolog / Symfony plain-text patterns
        // Pattern 1: Monolog: [2024-12-14 10:00:00] app.ERROR: message
        stage.regex {
            expression = "(?i)^\\[[^\\]]+\\]\\s+[\\w\\.]+\\.(?P<level>ERROR|WARNING|WARN|INFO|DEBUG|NOTICE|CRITICAL|ALERT|EMERGENCY):"
        }

        // Pattern 2: PHP native errors: PHP Fatal error: ... / PHP Warning: ...
        stage.regex {
            expression = "(?i)^PHP\\s+(?P<level>Fatal error|Warning|Notice|Parse error|Deprecated|Strict Standards)"
        }

        // Pattern 3: Generic prefix: ERROR: message / [ERROR] message
        stage.regex {
            expression = "(?i)^(?:\\[)?(?P<level>ERROR|WARN|WARNING|INFO|DEBUG|NOTICE|CRITICAL|ALERT|EMERGENCY)(?:\\])?(?::|\\s+)"
        }

        stage.labels {
            values = {
                level = "",
            }
        }
    }

    // Send to final output
    forward_to = [loki.write.local.receiver]
}

// ============================================
// APACHE HOST LOGS (Legacy Applications)
// Files from /var/log/apache2 on the host
// ============================================

// 6. Discover Apache log files from host
local.file_match "apache_host_logs" {
    path_targets = [
        {"__path__" = "/var/log/apache2/*access*.log", "log_type" = "access"},
        {"__path__" = "/var/log/apache2/*error*.log", "log_type" = "error"},
        {"__path__" = "/var/log/apache2/other_vhosts_access.log", "log_type" = "access"},
    ]
}

// 7. Read Apache log files
loki.source.file "apache_host" {
    targets    = local.file_match.apache_host_logs.targets
    forward_to = [loki.process.apache_host.receiver]
}

// 8. Process Apache host logs
loki.process "apache_host" {
    
    // Add static labels for identification
    stage.static_labels {
        values = {
            job       = "apache-host",
            source    = "file",
            container = "apache-host",
            instance  = sys.env("DOMAIN"),
        }
    }

    // Extract vhost from filename (e.g., example.com-access.log)
    stage.regex {
        expression = ".*/(?P<host>[^/]+?)[-_]?(access|error)\\.log$"
        source     = "filename"
    }
    stage.labels {
        values = {
            host = "",
        }
    }

    // ============================================
    // ACCESS LOG PIPELINE (Combined Format)
    // Format: %h %l %u %t "%r" %>s %b "%{Referer}i" "%{User-agent}i"
    // Example: 192.168.1.1 - - [14/Dec/2024:16:30:00 +0100] "GET /index.html HTTP/1.1" 200 1234 "-" "Mozilla/5.0..."
    // ============================================
    stage.match {
        selector = "{log_type=\"access\"}"
        
        stage.regex {
            expression = "^(?P<client_ip>[\\d.]+) (?P<identd>\\S+) (?P<user>\\S+) \\[(?P<timestamp>[^\\]]+)\\] \"(?P<method>\\w+) (?P<path>[^ ]*) [^\"]*\" (?P<status>\\d+) (?P<bytes>\\d+|-) \"(?P<referer>[^\"]*)\" \"(?P<user_agent>[^\"]*)\""
        }
        
        stage.labels {
            values = {
                method    = "",
                status    = "",
            }
        }
        
        // Parse Apache timestamp format: 14/Dec/2024:16:30:00 +0100
        stage.timestamp {
            source = "timestamp"
            format = "02/Jan/2006:15:04:05 -0700"
        }
    }

    // ============================================
    // ERROR LOG PIPELINE
    // Format: [Day Mon DD HH:MM:SS.microseconds YYYY] [module:level] [pid PID] [client IP:PORT] message
    // Example: [Sat Dec 14 16:30:00.123456 2024] [php:error] [pid 12345] [client 192.168.1.1:54321] Error message
    // Note: Timestamp parsing disabled - Apache error logs don't include timezone,
    //       which causes "timestamp too new" errors. Using ingestion time instead.
    // ============================================
    stage.match {
        selector = "{log_type=\"error\"}"
        
        stage.regex {
            expression = "^\\[(?P<timestamp>[^\\]]+)\\] \\[(?P<module>[^:]*):(?P<level>[^\\]]+)\\]( \\[pid (?P<pid>\\d+)\\])?( \\[client (?P<client_ip>[^:]+):\\d+\\])? (?P<message>.*)"
        }
        
        stage.labels {
            values = {
                level     = "",
                module    = "",
            }
        }
        
        // Timestamp parsing intentionally omitted - see note above
    }

    forward_to = [loki.write.local.receiver]
}

// 9. Send to Loki (Output)
loki.write "local" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}

// ============================================
// METRICS PIPELINE (PROMETHEUS)
// ============================================

// A. Host Metrics (Node Exporter equivalent)
prometheus.exporter.unix "host" {
    procfs_path = "/host/proc"
    sysfs_path  = "/host/sys"
    rootfs_path = "/host/root"
}

// B. Alloy Self Monitoring
prometheus.exporter.self "alloy" {}

// C. Scrape Targets
prometheus.scrape "metrics" {
    targets = [
        {"__address__" = "traefik:8080", "job" = "traefik"},
        {"__address__" = "crowdsec:6060", "job" = "crowdsec"},
        {"__address__" = "redis-exporter:9121", "job" = "redis"},
        {"__address__" = "postgres-exporter:9187", "job" = "postgres"},
        {"__address__" = "localhost:12345", "job" = "alloy"},
    ]
    
    forward_to = [prometheus.remote_write.local.receiver]
}

// Scrape host metrics (Node Exporter)
prometheus.scrape "node_exporter" {
    targets    = prometheus.exporter.unix.host.targets
    forward_to = [prometheus.relabel.node_exporter.receiver]
}

// Relabel metrics to match standard dashboard expectations
prometheus.relabel "node_exporter" {
    forward_to = [prometheus.remote_write.local.receiver]

    // Set a standard job name that dashboards look for
    rule {
        target_label = "job"
        replacement  = "node_exporter"
    }

    // Set the instance label to the domain name for easier filtering
    rule {
        target_label = "instance"
        replacement  = sys.env("DOMAIN")
    }
}

// D. Send to Prometheus (Output)
prometheus.remote_write "local" {
    endpoint {
        url = "http://prometheus:9090/api/v1/write"
        headers = {
            "Authorization" = "Bearer " + sys.env("PROMETHEUS_REMOTE_WRITE_TOKEN"),
        }
    }
}